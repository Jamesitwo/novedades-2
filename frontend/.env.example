# =============================================
# GestionNovedades - Frontend Variables
# Copiar a .env.local para desarrollo o .env.production para produccion
# =============================================

# URL de la API backend. En produccion dejar vacio si frontend y backend comparten dominio.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=GestionNovedades
# URL publica del sitio (usada para metadata SEO server-side cuando API_URL esta vacio)
NEXT_PUBLIC_SITE_URL=https://pizdo.info
# Cloudinary (widget de subida en registro de garantias)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dgbz1ze71
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=garantias_preset
